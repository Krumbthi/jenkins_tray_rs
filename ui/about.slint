//! About dialog - migrated from the original C# `JenkinsTray.UI.AboutForm`.

import { Theme } from "theme.slint";

export component AboutWindow inherits Window {
    title: "About Jenkins Tray";
    preferred-width: 300px;
    preferred-height: 210px;
    min-width: 300px;
    max-width: 300px;
    min-height: 210px;
    max-height: 210px;
    background: Theme.window-gradient;

    in property <string> version: "Version -";

    callback open-link(url: string);

    VerticalLayout {
        padding: 16px;
        spacing: 6px;

        Text {
            text: @tr("Jenkins Tray");
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // Small brand rule under the title.
        Rectangle {
            height: 2px;
            background: Theme.accent-gradient;
        }

        Text {
            text: root.version;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }

        Rectangle { height: 10px; }

        Rectangle {
            height: 22px;
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.open-link("https://github.com/Krumbthi/jenkins_tray_rs.git"); }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: "https://github.com/Krumbthi/jenkins_tray_rs.git";
                color: Theme.link;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: @tr("Author: Thilo Krumbholz");
            color: Theme.text-subtle;
            horizontal-alignment: center;
            font-size: 11px;
        }
    }
}
