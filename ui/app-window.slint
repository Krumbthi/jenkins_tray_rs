//! Main application window UI definition.
//!
//! Migrated from the original C# `JenkinsTray.UI.MainForm`:
//! toolbar (Settings / Refresh / Check for updates / About - no Exit
//! button, removed on request; exiting stays in the tray menu),
//! projects grid grouped by server, context menu, F5 refresh plus arrow
//! key / Return / Menu key navigation and the "Last check:" status bar.

import { Button, ListView } from "std-widgets.slint";
import { ProjectRow, Ui, TableHeader, ProjectRowView } from "common.slint";
import { AppVersion } from "version.slint";
import { SettingsWindow } from "settings.slint";
import { EditServerWindow } from "edit-server.slint";
import { AboutWindow } from "about.slint";
import { AuthTokenWindow, BuildParamsWindow, ClaimBuildWindow, MessageBoxWindow } from "dialogs.slint";

export { SettingsWindow, EditServerWindow, AboutWindow, AuthTokenWindow, BuildParamsWindow, ClaimBuildWindow, MessageBoxWindow }

export component AppWindow inherits Window {
    // Application icon (from the original JenkinsTray.ico).
    icon: @image-url("../assets/icon_64.png");
    // original: string.Format("{0} v{1}.{2}.{3}", ProductName, FileMajor,
    // FileMinor, FileBuild) - generated from CARGO_PKG_VERSION by build.rs.
    title: AppVersion.window-title();
    preferred-width: 900px;
    min-width: 700px;
    preferred-height: 460px;
    min-height: 320px;

    // Project rows (server group headers + projects), filled from Rust.
    in-out property <[ProjectRow]> rows;
    in-out property <int> selected-row: -1;
    in property <bool> integrate-claim: false;
    in-out property <string> last-check: "Last check: -";
    in-out property <string> status-text;

    // Active grid sort, kept in sync with Rust (original: the DevExpress
    // sort glyph in the column header). -1 = unsorted.
    in-out property <int> sort-column: -1;
    in-out property <bool> sort-ascending: true;

    // Checkmarks of the "Acknowledge ..." menu items, synced from Rust
    // whenever the selection changes.
    in-out property <bool> selected-ack-status: false;
    in-out property <bool> selected-ack-project: false;

    // Callbacks wired up from Rust.
    callback refresh-projects();
    callback open-settings();
    callback check-for-updates();
    callback open-about();
    callback activate-project();
    callback menu-action(action: string);
    callback selection-changed(row-index: int);
    // Keyboard row navigation (new feature; the original's WinForms grid
    // moves the selection with the arrow keys): computed in Rust (it needs
    // loops, which Slint functions do not have) - server group headers are
    // skipped, the selection never leaves the grid, and the same
    // `selection-changed` callback fires as on a click, so the menu
    // checkmarks stay in sync. The ListView does not scroll along yet: the
    // selected row may stay out of view in long lists.
    callback move-selection(delta: int);
    callback sort-changed(column: int);

    // Selection state used to enable/disable the context menu items
    // (mirrors MainForm.contextMenuStrip_Opening).
    property <bool> has-selection: selected-row >= 0 && selected-row < rows.length && !rows[selected-row].is-header;
    property <bool> sel-in-progress: has-selection && rows[selected-row].in-progress;
    property <bool> sel-queued: has-selection && rows[selected-row].queued;
    property <bool> sel-not-ok: has-selection && rows[selected-row].ack-status-eligible;
    property <bool> sel-claimable: integrate-claim && has-selection && rows[selected-row].claim-eligible;

    // F5 refresh (original: MainForm_KeyUp); the arrows, Return and the
    // Menu key are handled by `grid-key` inside the grid below - focus
    // must live within the ContextMenuArea for the Menu key to reach it.
    forward-focus: grid-key;

    VerticalLayout {
        // --- Toolbar (original: DevExpress main menu bar) ---
        Rectangle {
            height: 30px;
            background: Ui.bar-bg;
            border-width: 1px;
            border-color: Ui.line;
            HorizontalLayout {
                padding: 3px;
                spacing: 4px;
                Button {
                    text: @tr("Settings");
                    width: 90px;
                    clicked => { root.open-settings(); }
                }
                Button {
                    text: @tr("Refresh");
                    width: 90px;
                    clicked => { root.refresh-projects(); }
                }
                Button {
                    text: @tr("Check for updates");
                    width: 140px;
                    clicked => { root.check-for-updates(); }
                }
                Button {
                    text: @tr("About");
                    width: 80px;
                    clicked => { root.open-about(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // --- Column headers (original: grid column captions + sort glyphs) ---
        TableHeader {
            show-claim-columns: root.integrate-claim;
            sort-column: root.sort-column;
            sort-ascending: root.sort-ascending;
            column-clicked(column) => { root.sort-changed(column); }
        }

        // --- Projects grid (original: projectsGridControl) ---
        grid-area := Rectangle {
            vertical-stretch: 1;
            background: #ffffff;

            if (root.rows.length == 0) : Text {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                text: @tr("No Jenkins servers or projects configured.\nUse \"Settings\" to add a server.");
                color: #808080;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // The rows' TouchArea grabs every press (including the right
            // button), so the right-click itself never reaches this area;
            // the rows raise `context-menu-requested` and the menu is opened
            // programmatically through `show()` at the pointer position
            // (converted from window coordinates via `absolute-position`).
            project-menu := ContextMenuArea {
                // Keyboard focus for the grid. It must sit *within* the
                // ContextMenuArea: the area shows the row menu on the Menu
                // key only while a FocusScope inside it has focus, and key
                // events bubble up from the focused element - rejected keys
                // (Menu, Tab) reach the ContextMenuArea / focus traversal.
                // Clicking a row focuses it as well (focus-on-click).
                grid-key := FocusScope {
                    key-pressed(event) => {
                        if (event.text == Key.F5) {
                            root.refresh-projects();
                            accept
                        } else if (event.text == Key.DownArrow) {
                            root.move-selection(1);
                            accept
                        } else if (event.text == Key.UpArrow) {
                            root.move-selection(-1);
                            accept
                        } else if (event.text == Key.Return && root.has-selection) {
                            // original: projectsGridView_DoubleClick
                            root.activate-project();
                            accept
                        } else {
                            reject
                        }
                    }

                    ListView {
                        for item[i] in root.rows: delegate := ProjectRowView {
                            project-row: item;
                            show-claim-columns: root.integrate-claim;
                            selected: i == root.selected-row && !item.is-header;
                            clicked => {
                                root.selected-row = i;
                                root.selection-changed(i);
                            }
                            double-clicked => {
                                root.selected-row = i;
                                root.selection-changed(i);
                                root.activate-project();
                            }
                            context-menu-requested(pos) => {
                                // WinForms/DevExpress grids select the row under
                                // the cursor before showing the context menu, so
                                // the menu actions target the right-clicked row.
                                root.selected-row = i;
                                root.selection-changed(i);
                                project-menu.show({
                                    x: delegate.absolute-position.x
                                        - grid-area.absolute-position.x + pos.x,
                                    y: delegate.absolute-position.y
                                        - grid-area.absolute-position.y + pos.y,
                                });
                            }
                        }
                    }
                }

                // Original contextMenuStrip item order.
                Menu {
                    MenuItem {
                        title: @tr("Open project page");
                        enabled: root.has-selection;
                        activated => { root.menu-action("open-page"); }
                    }
                    MenuItem {
                        title: @tr("View console output");
                        enabled: root.has-selection;
                        activated => { root.menu-action("console"); }
                    }
                    MenuItem {
                        // original: hidden while a build is in progress
                        // (Slint menus cannot hide items, so it is disabled).
                        title: @tr("Run build");
                        enabled: root.has-selection && !root.sel-in-progress;
                        activated => { root.menu-action("run-build"); }
                    }
                    MenuItem {
                        // New feature (not in the original): the original only
                        // posts `/build?delay=0sec`, which does not queue a run
                        // on parameterized jobs; this opens the dialog that
                        // posts `buildWithParameters` like the reference script
                        // `jenkins_files/trigger_pipeline.sh`.
                        title: @tr("Build with parameters…");
                        enabled: root.has-selection && !root.sel-in-progress;
                        activated => { root.menu-action("run-build-params"); }
                    }
                    MenuItem {
                        title: root.sel-queued && !root.sel-in-progress
                            ? @tr("Cancel queue")
                            : @tr("Abort build");
                        enabled: root.has-selection && (root.sel-in-progress || root.sel-queued);
                        activated => { root.menu-action("abort-build"); }
                    }
                    MenuSeparator {}
                    MenuItem {
                        // original: disabled while the project itself is
                        // acknowledged, enabled only for stuck/indeterminate
                        // statuses and above.
                        title: @tr("Acknowledge status");
                        enabled: root.has-selection && root.sel-not-ok
                            && !root.selected-ack-project;
                        checkable: true;
                        checked <=> root.selected-ack-status;
                        activated => { root.menu-action("ack-status"); }
                    }
                    MenuItem {
                        title: @tr("Acknowledge project");
                        enabled: root.has-selection;
                        checkable: true;
                        checked <=> root.selected-ack-project;
                        activated => { root.menu-action("ack-project"); }
                    }
                    MenuSeparator {}
                    MenuItem {
                        title: @tr("Set authentication token");
                        enabled: root.has-selection;
                        activated => { root.menu-action("auth-token"); }
                    }
                    MenuSeparator {}
                    MenuItem {
                        // original: hidden unless the Claim integration is
                        // enabled (Slint menus cannot hide items, so it is
                        // disabled instead).
                        title: @tr("Claim this build");
                        enabled: root.sel-claimable;
                        activated => { root.menu-action("claim-build"); }
                    }
                    MenuSeparator {}
                    MenuItem {
                        title: @tr("Remove project");
                        enabled: root.has-selection;
                        activated => { root.menu-action("remove-project"); }
                    }
                }
            }
        }

        // --- Status bar (original: bar3 with "Last check: ...") ---
        Rectangle {
            height: 26px;
            background: Ui.bar-bg;
            border-width: 1px;
            border-color: Ui.line;
            Text {
                x: 8px;
                width: parent.width / 2 - 12px;
                height: parent.height;
                text: root.last-check;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: parent.width / 2;
                width: parent.width / 2 - 10px;
                height: parent.height;
                text: root.status-text;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                color: #606060;
            }
        }
    }
}

// System Tray Icon - Slint's built-in `SystemTrayIcon` (the exact mechanism
// the user's project_tracker client uses; on Windows it wraps
// Shell_NotifyIconW internally). A `SystemTrayIcon` is a top-level component
// with no window of its own, so it is defined next to (not inside) AppWindow.
export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("tray.svg");
    tooltip: "Jenkins Tray";

    // Wired from Rust (see `main.rs`): the menu mirrors the original
    // NotifyIcon context menu (Open / Settings / Refresh / About / Exit).
    callback show-window();
    callback hide-window();
    callback open-settings();
    callback refresh-projects();
    callback show-about();
    callback quit-app();

    // Left-click on the tray icon (fires on Windows/macOS/Linux) brings
    // the window back — equivalent to the original's notifyIcon double-click.
    clicked => { show-window(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { show-window(); }
        }
        MenuItem {
            title: "Hide";
            activated => { hide-window(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Settings";
            activated => { open-settings(); }
        }
        MenuItem {
            title: "Refresh";
            activated => { refresh-projects(); }
        }
        MenuItem {
            title: "About";
            activated => { show-about(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Exit";
            activated => { quit-app(); }
        }
    }
}
